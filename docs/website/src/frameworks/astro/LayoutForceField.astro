---
/**
 * LayoutForceField — Astro island visualizing the OR layout engine's
 * stress-majorization attraction field for VGP's design hub. Deterministic
 * force vectors illustrate how call/import edges pull nodes toward a
 * converged layout around a root node, matching the design-hub / roadmap
 * concepts in docs/content/architecture.md without shipping the actual
 * C++/Python layout engine.
 */
interface Props {
  /** Deterministic seed for layout (stable static export). */
  seed?: number;
  /** Grid resolution along each axis. */
  resolution?: number;
  /** Show import-edge attraction vectors. */
  showImports?: boolean;
  /** Accessible title. */
  title?: string;
  /** Optional subtitle shown under the title. */
  subtitle?: string;
}

const {
  seed = 1540,
  resolution = 14,
  showImports = true,
  title = 'Layout force field',
  subtitle = 'Call & import edges pulling nodes toward a converged layout (illustrative force vectors)',
} = Astro.props;

/** Mulberry32 — tiny seeded PRNG for build-time determinism. */
function mulberry32(a: number) {
  return function next() {
    let t = (a += 0x6d2b79f5);
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = mulberry32(seed);
const width = 720;
const height = 360;
const cellW = width / resolution;
const cellH = height / resolution;

// Root node sits inland (right-center); import-heavy nodes cluster to the left third.
const root = { x: width * 0.78, y: height * 0.48 };
const importEdge = width * 0.28;

type Arrow = {
  x: number;
  y: number;
  angle: number;
  kind: 'call' | 'import';
  strength: number;
};

const arrows: Arrow[] = [];

for (let gy = 0; gy < resolution; gy++) {
  for (let gx = 0; gx < resolution; gx++) {
    const cx = (gx + 0.5) * cellW;
    const cy = (gy + 0.5) * cellH;
    const dx = root.x - cx;
    const dy = root.y - cy;
    const dist = Math.hypot(dx, dy) || 1;
    // Base field points toward the root node; add mild curl noise for edge lanes.
    const noise = (rand() - 0.5) * 0.55;
    const baseAngle = Math.atan2(dy, dx) + noise;
    const kind: 'call' | 'import' = cx < importEdge ? 'import' : 'call';
    if (kind === 'import' && !showImports) continue;
    // Soften arrows very near the root node.
    if (dist < 36) continue;
    arrows.push({
      x: cx,
      y: cy,
      angle: baseAngle,
      kind,
      strength: Math.min(1, 48 / dist + 0.35),
    });
  }
}

// Sample convergence paths (polylines) showing nodes migrating toward the root.
function samplePath(startY: number, importLane: boolean): string {
  const pts: string[] = [];
  let x = importLane ? 12 : importEdge + 8;
  let y = startY;
  for (let i = 0; i < 28; i++) {
    pts.push(`${x.toFixed(1)},${y.toFixed(1)}`);
    const dx = root.x - x;
    const dy = root.y - y;
    const ang = Math.atan2(dy, dx) + (rand() - 0.5) * 0.35;
    x += Math.cos(ang) * 18;
    y += Math.sin(ang) * 18;
    if (Math.hypot(root.x - x, root.y - y) < 28) break;
  }
  pts.push(`${root.x},${root.y}`);
  return pts.join(' ');
}

const callPaths = [height * 0.25, height * 0.55, height * 0.78].map((y) => samplePath(y, false));
const importPaths = showImports
  ? [height * 0.35, height * 0.65].map((y) => samplePath(y, true))
  : [];

const islandId = `lff-${seed}-${resolution}`;
---

<section
  class="layout-force-field"
  id={islandId}
  data-seed={seed}
  aria-labelledby={`${islandId}-title`}
>
  <header class="lff-header">
    <div>
      <p class="lff-kicker">Astro island · design hub</p>
      <h2 id={`${islandId}-title`}>{title}</h2>
      <p class="lff-sub">{subtitle}</p>
    </div>
    <ul class="lff-legend" aria-label="Legend">
      <li><span class="swatch call"></span> Call-edge attraction vectors</li>
      {showImports && <li><span class="swatch import"></span> Import-edge attraction vectors</li>}
      <li><span class="swatch path"></span> Sample convergence paths</li>
      <li><span class="swatch root"></span> Root node</li>
    </ul>
  </header>

  <div class="lff-stage">
    <svg
      viewBox={`0 0 ${width} ${height}`}
      role="img"
      aria-describedby={`${islandId}-desc`}
      class="lff-svg"
    >
      <title>{title}</title>
      <desc id={`${islandId}-desc`}>
        Deterministic force-field diagram of call and import edges converging on a root node.
        Arrows indicate the stress-majorization attraction direction; illustrative only.
      </desc>

      <!-- Import / call background bands -->
      <rect x="0" y="0" width={importEdge} height={height} class="band import-band" />
      <rect x={importEdge} y="0" width={width - importEdge} height={height} class="band call-band" />
      <line x1={importEdge} y1="0" x2={importEdge} y2={height} class="edge-line" />

      <!-- Sample paths -->
      {importPaths.map((pts) => (
        <polyline points={pts} class="convergence-path import-path" />
      ))}
      {callPaths.map((pts) => (
        <polyline points={pts} class="convergence-path call-path" />
      ))}

      <!-- Flow arrows -->
      {arrows.map((a) => {
        const len = 10 + a.strength * 8;
        const x2 = a.x + Math.cos(a.angle) * len;
        const y2 = a.y + Math.sin(a.angle) * len;
        return (
          <g class:list={['arrow', a.kind]} data-kind={a.kind}>
            <line x1={a.x} y1={a.y} x2={x2} y2={y2} />
            <circle cx={a.x} cy={a.y} r="1.4" />
          </g>
        );
      })}

      <!-- Root node -->
      <g class="root-node" transform={`translate(${root.x}, ${root.y})`}>
        <circle r="22" class="root-ring" />
        <rect x="-10" y="-10" width="20" height="20" rx="3" class="root-body" />
        <text y="36" text-anchor="middle" class="root-label">Root node</text>
      </g>
    </svg>

    <aside class="lff-panel" aria-live="polite">
      <h3>Vector read-out</h3>
      <p data-readout>
        Hover a vector region to inspect edge kind. Flow points toward the root node, mirroring how stress
        majorization pulls call- and import-connected nodes into a converged layout.
      </p>
      <dl>
        <div><dt>Seed</dt><dd>{seed}</dd></div>
        <div><dt>Resolution</dt><dd>{resolution}×{resolution}</dd></div>
        <div><dt>Vectors</dt><dd data-count>{arrows.length}</dd></div>
      </dl>
    </aside>
  </div>

  <p class="lff-note">
    Built as a static Astro island: purely a design-hub visualization, not the actual OR layout engine in backend/.
  </p>
</section>

<style>
  .layout-force-field {
    --lff-ink: #1e293b;
    --lff-muted: #64748b;
    --lff-import: #0ea5e9;
    --lff-call: #ca8a04;
    --lff-path: #f43f5e;
    --lff-root: #fbbf24;
    --lff-panel: color-mix(in srgb, var(--surface, #0f172a) 92%, transparent);
    color: var(--text, var(--lff-ink));
    background: var(--surface, #0b1220);
    border: 1px solid var(--border, rgba(148, 163, 184, 0.25));
    border-radius: 14px;
    padding: 1.25rem 1.35rem 1rem;
    margin: 1.5rem 0;
  }
  .lff-header {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .lff-kicker {
    margin: 0 0 0.25rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted, var(--lff-muted));
  }
  .lff-header h2 {
    margin: 0;
    font-size: 1.25rem;
  }
  .lff-sub {
    margin: 0.35rem 0 0;
    color: var(--text-muted, var(--lff-muted));
    font-size: 0.92rem;
    max-width: 36rem;
  }
  .lff-legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
    font-size: 0.82rem;
    color: var(--text-muted, var(--lff-muted));
  }
  .lff-legend li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .swatch {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 3px;
    display: inline-block;
  }
  .swatch.call { background: var(--lff-call); }
  .swatch.import { background: var(--lff-import); }
  .swatch.path { background: var(--lff-path); }
  .swatch.root { background: var(--lff-root); }

  .lff-stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(12rem, 15rem);
    gap: 1rem;
  }
  @media (max-width: 800px) {
    .lff-stage { grid-template-columns: 1fr; }
  }
  .lff-svg {
    width: 100%;
    height: auto;
    border-radius: 10px;
    display: block;
    background: #020617;
  }
  .band.import-band { fill: rgba(14, 165, 233, 0.12); }
  .band.call-band { fill: rgba(202, 138, 4, 0.08); }
  .edge-line {
    stroke: rgba(148, 163, 184, 0.45);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
  }
  .convergence-path {
    fill: none;
    stroke: var(--lff-path);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.75;
  }
  .convergence-path.import-path { stroke: #38bdf8; }
  .arrow line {
    stroke-width: 1.25;
    stroke-linecap: round;
  }
  .arrow.call line, .arrow.call circle { stroke: var(--lff-call); fill: var(--lff-call); }
  .arrow.import line, .arrow.import circle { stroke: var(--lff-import); fill: var(--lff-import); }
  .arrow.is-hot line { stroke-width: 2.25; filter: drop-shadow(0 0 4px currentColor); }
  .root-ring {
    fill: rgba(251, 191, 36, 0.12);
    stroke: var(--lff-root);
    stroke-width: 2;
  }
  .root-body {
    fill: rgba(251, 191, 36, 0.85);
    stroke: #78350f;
    stroke-width: 1;
  }
  .root-label {
    fill: #fde68a;
    font-size: 11px;
    font-family: system-ui, sans-serif;
  }
  .lff-panel {
    background: var(--lff-panel);
    border: 1px solid var(--border, rgba(148, 163, 184, 0.2));
    border-radius: 10px;
    padding: 0.85rem 1rem;
    font-size: 0.88rem;
  }
  .lff-panel h3 {
    margin: 0 0 0.5rem;
    font-size: 0.95rem;
  }
  .lff-panel p { margin: 0 0 0.75rem; color: var(--text-muted, var(--lff-muted)); }
  .lff-panel dl {
    display: grid;
    gap: 0.35rem;
    margin: 0;
  }
  .lff-panel dl div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .lff-panel dt { color: var(--text-muted, var(--lff-muted)); }
  .lff-panel dd { margin: 0; font-variant-numeric: tabular-nums; }
  .lff-note {
    margin: 0.75rem 0 0;
    font-size: 0.78rem;
    color: var(--text-muted, var(--lff-muted));
  }
  @media (prefers-reduced-motion: reduce) {
    .arrow.is-hot line { filter: none; }
  }
</style>

<script>
  // Lightweight client enhancement: highlight nearby vectors on pointer move.
  const root = document.currentScript?.previousElementSibling?.closest?.('.layout-force-field')
    ?? document.querySelector('.layout-force-field');
  if (root) {
    const svg = root.querySelector('.lff-svg');
    const readout = root.querySelector('[data-readout]');
    const arrows = Array.from(root.querySelectorAll('.arrow'));

    function clearHot() {
      arrows.forEach((a) => a.classList.remove('is-hot'));
    }

    svg?.addEventListener('pointermove', (event) => {
      const e = event as PointerEvent;
      const target = (e.target as Element | null)?.closest?.('.arrow');
      clearHot();
      if (!target) {
        if (readout) {
          readout.textContent =
            'Hover a vector region to inspect edge kind. Flow points toward the root node, mirroring how stress majorization pulls call- and import-connected nodes into a converged layout.';
        }
        return;
      }
      target.classList.add('is-hot');
      const kind = target.getAttribute('data-kind') === 'import' ? 'Import' : 'Call';
      if (readout) {
        readout.textContent = `${kind}-edge attraction vector — this is the pull stress majorization applies toward the root node before the MIP refinement pass.`;
      }
    });

    svg?.addEventListener('pointerleave', () => {
      clearHot();
      if (readout) {
        readout.textContent =
          'Hover a vector region to inspect edge kind. Flow points toward the root node, mirroring how stress majorization pulls call- and import-connected nodes into a converged layout.';
      }
    });
  }
</script>
