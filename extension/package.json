{
  "name": "vgp-extension",
  "displayName": "Visual Graph Programming",
  "description": "Interactive code property graph visualization inside VS Code — dependency maps, bidirectional call graphs, and graph-to-source navigation.",
  "version": "0.1.0",
  "publisher": "ACFHarbinger",
  "repository": {
    "type": "git",
    "url": "https://github.com/ACFHarbinger/Visual-Graph-Programming.git",
    "directory": "extension"
  },
  "license": "SEE LICENSE IN ../LICENSE.md",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:cpp",
    "onLanguage:python",
    "onLanguage:typescript"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vgp.showGraph",
        "title": "VGP: Show Code Graph"
      },
      {
        "command": "vgp.showCallHierarchyGraph",
        "title": "VGP: Show Call Hierarchy Graph"
      },
      {
        "command": "vgp.exportGraph",
        "title": "VGP: Export Graph (Mermaid / PlantUML)"
      }
    ],
    "configuration": {
      "title": "Visual Graph Programming",
      "properties": {
        "vgp.graphService.endpoint": {
          "type": "string",
          "default": "ws://127.0.0.1:7431",
          "description": "WebSocket endpoint of the VGP base graph service."
        },
        "vgp.filter.excludeGlobs": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["**/node_modules/**", "**/build/**", "**/dist/**"],
          "description": "Glob patterns hidden from the graph by default."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run check-types && node esbuild.mjs --production",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package --no-dependencies",
    "docs": "typedoc --options ../docs/extension/typedoc.json"
  },
  "dependencies": {
    "web-tree-sitter": "^0.25.6"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.1.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.11.0",
    "prettier": "^3.3.3",
    "typedoc": "^0.26.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
