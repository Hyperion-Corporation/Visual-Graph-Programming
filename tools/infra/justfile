# tools/infra/justfile
# Optional, always-on backend (infra/docker/) recipes — see infra/README.md.
# Not required for the extension, app, or plugin.

set shell := ["bash", "-c"]
set working-directory := '../..'

cyan := '\033[0;36m'
reset := '\033[0m'

# Start the optional backend stack locally
docker-up:
    @echo -e "{{cyan}}Starting optional backend stack...{{reset}}"
    docker compose -f infra/docker/docker-compose.yml up --build

# Stop the optional backend stack
docker-down:
    docker compose -f infra/docker/docker-compose.yml down
